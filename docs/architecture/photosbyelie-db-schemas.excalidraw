      "boundElements": null,
      "updated": 1779170000000,
      "link": null,
      "locked": false,
      "text": "JSON files, when still present, are views/audit/compatibility exports.\nThey are not authoritative state for either schema.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "JSON files, when still present, are views/audit/compatibility exports.\nThey are not authoritative state for either schema.",
