      "updated": 1779170000000,
      "link": null,
      "locked": false,
      "text": "Note: public media_assets triggers enforce photo/video asset invariants. Indexes/triggers are omitted from the card bodies to keep the map readable.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Note: public media_assets triggers enforce photo/video asset invariants. Indexes/triggers are omitted from the card bodies to keep the map readable.",
      "lineHeight": 1.25,
      "font": "13px Virgil"
    },
