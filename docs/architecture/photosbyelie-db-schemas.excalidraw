      "updated": 1779170000000,
      "link": null,
      "locked": false,
      "text": "PK: primary key\nFK: foreign key\nNN: NOT NULL\nsolid arrows: SQLite foreign-key relationships\ndashed purple arrows: process-derived state crossing the catalog/owner boundary",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "PK: primary key\nFK: foreign key\nNN: NOT NULL\nsolid arrows: SQLite foreign-key relationships\ndashed purple arrows: process-derived state crossing the catalog/owner boundary",
      "lineHeight": 1.25,
      "font": "13px Virgil"
    },
    {
